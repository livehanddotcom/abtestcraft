}) }}

<hr>

<h2>Who's Counted</h2>

{{ forms.lightswitchField({
    label: "Exclude Bots"|t('abtestcraft'),
    instructions: "Known bots, crawlers, link previews and monitoring services see the control and aren't counted. Bots don't keep cookies, so without this each of their requests counts as a new visitor."|t('abtestcraft'),
    id: 'excludeBots',
    name: 'excludeBots',
    on: settings.excludeBots,
}) }}

{{ forms.lightswitchField({
    label: "Exclude Control Panel Users"|t('abtestcraft'),
    instructions: "People logged in with control panel access see the control and aren't counted, so editors checking their own pages don't skew results. To see a variant on the real page, add `?abtestcraft=variant` (or `?abtestcraft=control`) to its URL while logged in; those views are never counted."|t('abtestcraft'),
    id: 'excludeControlPanelUsers',
    name: 'excludeControlPanelUsers',
    on: settings.excludeControlPanelUsers,
}) }}

<hr>

<h2>Consent</h2>

{{ forms.lightswitchField({
    label: "Require Consent"|t('abtestcraft'),
    instructions: "Only include visitors who've given consent. Everyone else sees the original page, gets no cookies and isn't counted, and visitors who withdraw consent are taken out of tests. Results then only reflect visitors who consented, and a conversion on the page where someone first consents isn't counted (they join tests from their next page view)."|t('abtestcraft'),
    id: 'requireConsent',
    name: 'requireConsent',
    on: settings.requireConsent,
    toggle: 'consent-settings',
}) }}

<div id="consent-settings" class="{{ settings.requireConsent ? '' : 'hidden' }}">
    {{ forms.selectField({
        label: "Google Consent Mode Signal"|t('abtestcraft'),
        instructions: "Most consent banners send Google Consent Mode. Which of its signals means a visitor can take part in tests? A/B testing measures behaviour, so `analytics_storage` (the \"analytics\" or \"statistics\" choice in most banners) fits most sites. Whether it's analytics or personalization is a legal call for each site."|t('abtestcraft'),
        id: 'consentModeSignal',
        name: 'consentModeSignal',
        options: [
            { label: 'analytics_storage (recommended)', value: 'analytics_storage' },
            { label: 'personalization_storage', value: 'personalization_storage' },
            { label: 'functionality_storage', value: 'functionality_storage' },
            { label: "Don't use Google Consent Mode", value: '' },
        ],
        value: settings.consentModeSignal,
        errors: settings.getErrors('consentModeSignal'),
    }) }}

    {{ forms.selectField({
        label: "Consent Banner Cookie"|t('abtestcraft'),
        instructions: "Also accept consent from a banner's own cookie (its analytics or statistics choice), for sites without Google's tag."|t('abtestcraft'),
        id: 'consentCookie',
        name: 'consentCookie',
        options: [
            { label: 'Detect automatically (all of the below)', value: 'auto' },
            { label: 'Cookiebot', value: 'cookiebot' },
            { label: 'CookieYes', value: 'cookieyes' },
            { label: 'Complianz', value: 'complianz' },
            { label: 'OneTrust', value: 'onetrust' },
            { label: 'CookieConsent (orestbida)', value: 'cookieconsent' },
            { label: 'Custom cookie', value: 'custom' },
            { label: "Don't use a banner cookie", value: 'none' },
        ],
        value: settings.consentCookie,
        errors: settings.getErrors('consentCookie'),
    }) }}

    {{ forms.textField({
        label: "OneTrust Group ID"|t('abtestcraft'),
        instructions: "For OneTrust: the ID of your performance/analytics cookie group. It's C0002 unless your OneTrust account uses different IDs (check under Cookie Categories)."|t('abtestcraft'),
        id: 'consentOneTrustGroup',
        name: 'consentOneTrustGroup',
        value: settings.consentOneTrustGroup,
        errors: settings.getErrors('consentOneTrustGroup'),
    }) }}

    {{ forms.textField({
        label: "Custom Cookie Name"|t('abtestcraft'),
        instructions: "For Custom cookie: the cookie your consent banner sets."|t('abtestcraft'),
        id: 'consentCookieName',
        name: 'consentCookieName',
        value: settings.consentCookieName,
        errors: settings.getErrors('consentCookieName'),
    }) }}

    {{ forms.textField({
        label: "Custom Cookie Value Contains"|t('abtestcraft'),
        instructions: "For Custom cookie: text its value contains when consent is given (for example `analytics:true`). Leave empty if the cookie only exists after consent."|t('abtestcraft'),
        id: 'consentCookieValue',
        name: 'consentCookieValue',
        value: settings.consentCookieValue,
        errors: settings.getErrors('consentCookieValue'),
    }) }}

    <div class="field">
        <div class="instructions">
            <p>For any other banner, or one that keeps consent in the browser's storage rather than a cookie (such as Usercentrics), rely on Google Consent Mode or call <code>ABTestCraft.setConsent(true)</code> (or <code>false</code>) from its JavaScript when the visitor chooses.</p>
        </div>
    </div>
</div>

<hr>

<h2>Rate Limiting</h2>

{{ forms.textField({
    label: "Conversion Rate Limit"|t('abtestcraft'),
    instructions: "Maximum conversions per minute per IP address per test. Helps prevent abuse."|t('abtestcraft'),
    id: 'conversionRateLimit',
    name: 'conversionRateLimit',
    type: 'number',
    min: 1,
    max: 100,
    value: settings.conversionRateLimit,
    errors: settings.getErrors('conversionRateLimit'),
}) }}

<hr>

<h2>Conversion Counting</h2>

{{ forms.selectField({
    label: "Conversion Counting Mode"|t('abtestcraft'),
    instructions: "How to count multiple conversions from the same visitor."|t('abtestcraft'),
    id: 'conversionCountingMode',
    name: 'conversionCountingMode',
    options: [
        { label: 'One per goal type (recommended)', value: 'per_goal_type' },
        { label: 'First conversion only (any goal)', value: 'first_only' },
        { label: 'All conversions (unlimited)', value: 'unlimited' },
    ],
    value: settings.conversionCountingMode,
    errors: settings.getErrors('conversionCountingMode'),
}) }}

<div class="field">
    <div class="instructions" style="margin-top: -16px;">
        <p style="color: #8f98a3; font-size: 12px;">
            <strong>One per goal type:</strong> A visitor can convert once per goal type (e.g., once for form, once for phone). Most accurate for multi-goal tests.<br>
            <strong>First conversion only:</strong> Only the first conversion counts, regardless of goal type. Useful when any goal is equally valuable.<br>
            <strong>All conversions:</strong> Every conversion is counted. May inflate conversion numbers but shows all user actions.
        </p>
    </div>
</div>

