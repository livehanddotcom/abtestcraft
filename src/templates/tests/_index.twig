{% extends "_layouts/cp" %}

{% set title = "Split Tests" %}
{% set selectedSubnavItem = "tests" %}

{# Site switcher on multi-site installs (tests belong to one site) #}
{% block contextMenu %}
    {% include "_elements/sitemenu" with {
        selectedSiteId: site.id,
        urlFormat: 'abtestcraft/tests?site={handle}&status=' ~ statusFilter,
    } only %}
{% endblock %}

{% block actionButton %}
    {% if canCreateTests %}
        <a href="{{ url('abtestcraft/tests/new', { site: site.handle }) }}" class="btn submit">New Test</a>
    {% else %}
        <span class="btn submit disabled" title="{{ 'License required to create new tests'|t('abtestcraft') }}" style="opacity: 0.5; cursor: not-allowed;">New Test</span>
    {% endif %}
{% endblock %}

{% block content %}
    {# License notices come from the CP alert registered in ABTestCraft::registerLicenseAlert() #}

    <style>
        .abtc-index { font-variant-numeric: tabular-nums; }
        .abtc-tabs { display: flex; gap: 4px; margin: -4px 0 20px; border-bottom: 1px solid #e2e8f0; }
        .abtc-tabs a {
            display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; margin-bottom: -1px;
            color: #475569; text-decoration: none; border-bottom: 2px solid transparent;
        }
        .abtc-tabs a:hover { color: #1e293b; }
        .abtc-tabs a.sel { color: #1e293b; font-weight: 600; border-bottom-color: #4f46e5; }
        .abtc-tabs a:focus-visible { outline: 2px solid #4f46e5; outline-offset: -2px; border-radius: 4px; }
        .abtc-tabs .abtc-count { padding: 1px 8px; border-radius: 10px; background: #f1f5f9; color: #64748b; font-size: 12px; font-weight: 500; }
        .abtc-tabs a.sel .abtc-count { background: #e0e7ff; color: #3730a3; }
        .abtc-tabs .abtc-trash { margin-left: auto; }
        .abtc-index table.data td { vertical-align: middle; padding-top: 12px; padding-bottom: 12px; }
        .abtc-index .abtc-name { font-weight: 600; }
        .abtc-index .abtc-sub { margin-top: 2px; font-size: 12px; color: #64748b; }
        .abtc-index .abtc-rate { font-weight: 600; color: #1e293b; }
        .abtc-index .abtc-up { color: #15803d; font-weight: 600; }
        .abtc-index .abtc-down { color: #b91c1c; font-weight: 600; }
        .abtc-index .abtc-muted { color: #64748b; }
        .abtc-index .abtc-progress { width: 96px; height: 6px; border-radius: 3px; background: #f1f5f9; overflow: hidden; }
        .abtc-index .abtc-progress div { height: 100%; border-radius: 3px; background: #4f46e5; }
        .abtc-index .abtc-progress.is-done div { background: #15803d; }
        .abtc-index .abtc-state { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; color: #1e293b; }
    </style>

    {# Status tabs #}
    {% set tabItems = [
        { key: 'active', label: 'Active' },
        { key: 'completed', label: 'Completed' },
        { key: 'all', label: 'All' },
        { key: 'trashed', label: 'Trash' },
    ] %}
    <nav class="abtc-tabs" aria-label="Filter tests by status">
        {% for tab in tabItems %}
            <a href="{{ url('abtestcraft/tests', { status: tab.key, site: site.handle }) }}"
               class="{{ statusFilter == tab.key ? 'sel' }} {{ tab.key == 'trashed' ? 'abtc-trash' }}"
               {% if statusFilter == tab.key %}aria-current="page"{% endif %}>
                {{ tab.label }}
                <span class="abtc-count">{{ counts[tab.key] }}</span>
            </a>
        {% endfor %}
    </nav>

    <div class="abtc-index">
    {% if statusFilter == 'trashed' %}
        {% if tests|length %}
            <p class="light">Tests in the trash don't run and can't be edited. Restore a test to use it again, or delete it permanently to remove it and all its results.</p>
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status before deleting</th>
                        <th>Deleted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in tests %}
                        {% set test = item.test %}
                        <tr>
                            <td>
                                <strong>{{ test.name }}</strong>
                                <div class="light">{{ test.handle }}</div>
                            </td>
                            <td>{{ test.status|capitalize }}</td>
                            <td>{{ test.dateDeleted|date('short') }}</td>
                            <td class="thin" style="white-space: nowrap;">
                                {% if canManageTests %}
                                    <form method="post" style="display: inline;">
                                        {{ csrfInput() }}
                                        {{ actionInput('abtestcraft/tests/restore') }}
                                        {{ redirectInput('abtestcraft/tests?status=trashed') }}
                                        <input type="hidden" name="testId" value="{{ test.id }}">
                                        <button type="submit" class="btn small">Restore</button>
                                    </form>
                                    <form method="post" style="display: inline;" class="abtestcraft-confirm"
                                          data-confirm="{{ 'Permanently delete “{name}” and all its results? This can’t be undone.'|t('abtestcraft', { name: test.name }) }}">
                                        {{ csrfInput() }}
                                        {{ actionInput('abtestcraft/tests/delete-permanently') }}
                                        {{ redirectInput('abtestcraft/tests?status=trashed') }}
                                        <input type="hidden" name="testId" value="{{ test.id }}">
                                        <button type="submit" class="btn small caution">Delete permanently</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% js %}
                document.querySelectorAll('form.abtestcraft-confirm').forEach(function(form) {
                    form.addEventListener('submit', function(e) {
                        if (!window.confirm(form.dataset.confirm)) {
                            e.preventDefault();
                        }
                    });
                });
            {% endjs %}
        {% else %}
            <div class="zilch">
                <p>The trash is empty.</p>
            </div>
        {% endif %}
    {% elseif tests|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">Test</th>
                    <th scope="col">Status</th>
                    <th scope="col">Original</th>
                    <th scope="col">Variant</th>
                    <th scope="col">Difference</th>
                    <th scope="col">Progress</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for item in tests %}
                    {% set test = item.test %}
                    {% set stats = item.stats %}
                    {% set timeEstimate = item.timeEstimate %}
                    {% set hasData = test.status != 'draft' and stats.totalVisitors > 0 %}
                    <tr>
                        <td>
                            <a class="abtc-name" href="{{ url('abtestcraft/tests/' ~ test.id ~ (test.status == 'draft' ? '' : '/results')) }}">{{ test.name }}</a>
                            <div class="abtc-sub"><code>{{ test.handle }}</code></div>
                        </td>
                        <td>
                            <span class="abtc-state">
                                {%- switch test.status -%}
                                    {%- case 'running' -%}<span class="status live" aria-hidden="true"></span>Running
                                    {%- case 'paused' -%}<span class="status orange" aria-hidden="true"></span>Paused
                                    {%- case 'completed' -%}<span class="status blue" aria-hidden="true"></span>Completed
                                    {%- default -%}<span class="status disabled" aria-hidden="true"></span>Draft
                                {%- endswitch -%}
                            </span>
                            {% if test.status == 'paused' and test.guardrailTriggeredAt %}
                                <div class="abtc-sub">By its safety guardrail</div>
                            {% elseif test.status == 'completed' %}
                                <div class="abtc-sub">
                                    {%- if test.isServingWinner() -%}Variant shown to everyone
                                    {%- elseif test.winnerVariant -%}{{ test.winnerVariant == 'variant' ? 'Variant' : 'Original' }} won
                                    {%- else -%}No winner{%- endif -%}
                                </div>
                            {% endif %}
                            {% if test.status in ['draft', 'paused'] and test.scheduledStartAt %}
                                <div class="abtc-sub">Starts {{ test.scheduledStartAt|datetime('short') }}</div>
                            {% elseif test.status == 'running' and test.scheduledEndAt %}
                                <div class="abtc-sub">Ends {{ test.scheduledEndAt|datetime('short') }}</div>
                            {% endif %}
                        </td>
                        {% for version in ['control', 'variant'] %}
                            <td>
                                {% if hasData %}
                                    <span class="abtc-rate">{{ stats.conversionRates[version] }}%</span>
                                    <div class="abtc-sub">{{ stats.convertedVisitors[version]|number }} of {{ stats.visitors[version]|number }}</div>
                                {% else %}
                                    <span class="abtc-muted">&mdash;</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                        <td>
                            {% set decided = stats.isSignificant or (test.status == 'completed' and test.winnerVariant) %}
                            {% if hasData and stats.improvement is not null %}
                                <span class="{{ decided ? (stats.improvement > 0 ? 'abtc-up' : (stats.improvement < 0 ? 'abtc-down')) : 'abtc-muted' }}">
                                    {{ stats.improvement > 0 ? '+' }}{{ stats.improvement }}%
                                </span>
                                <div class="abtc-sub">
                                    {%- if stats.isSignificant -%}{{ (stats.confidence * 100)|number_format(1) }}% confidence
                                    {%- elseif stats.verdictReady -%}No significant difference
                                    {%- elseif test.status != 'completed' -%}Too early to call
                                    {%- else -%}{{ (stats.confidence * 100)|number_format(1) }}% confidence{%- endif -%}
                                </div>
                            {% else %}
                                <span class="abtc-muted">&mdash;</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if test.status in ['running', 'paused'] and hasData %}
                                {% set progress = min(100, stats.progressPercent|default(0)) %}
                                <div class="abtc-progress {{ stats.verdictReady ? 'is-done' }}" role="img" aria-label="{{ progress }}% of the planned sample">
                                    <div style="width: {{ max(progress, 3) }}%;"></div>
                                </div>
                                <div class="abtc-sub">
                                    {%- if stats.isSignificant -%}Winner found
                                    {%- elseif stats.verdictReady -%}Sample reached
                                    {%- elseif test.status == 'running' and timeEstimate and not timeEstimate.reached -%}About {{ timeEstimate.daysRemaining }} days left
                                    {%- else -%}{{ progress }}% of sample{%- endif -%}
                                </div>
                            {% elseif test.status == 'completed' %}
                                {% set duration = test.getDurationDays() %}
                                {% if duration %}
                                    <span>{{ duration }} day{{ duration != 1 ? 's' }}</span>
                                    <div class="abtc-sub">{{ stats.totalVisitors|number }} visitors</div>
                                {% endif %}
                            {% else %}
                                <span class="abtc-muted">&mdash;</span>
                            {% endif %}
                        </td>
                        <td class="thin" style="white-space: nowrap;">
                            {% if test.status != 'draft' %}
                                <a href="{{ url('abtestcraft/tests/' ~ test.id ~ '/results') }}" class="btn small">Results</a>
                            {% endif %}
                            <a href="{{ url('abtestcraft/tests/' ~ test.id) }}" class="btn small">Edit</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="zilch">
            {% if statusFilter == 'active' %}
                <p>No active tests.</p>
                {% if counts.all == 0 %}
                    {% if canCreateTests %}
                        <a href="{{ url('abtestcraft/tests/new', { site: site.handle }) }}" class="btn submit">Create your first test</a>
                    {% else %}
                        <p style="margin-top: 12px; color: #856404;">
                            <a href="{{ url('plugin-store/abtestcraft') }}" class="go">{{ 'Purchase a license'|t('abtestcraft') }}</a> {{ 'to create tests.'|t('abtestcraft') }}
                        </p>
                    {% endif %}
                {% endif %}
            {% elseif statusFilter == 'completed' %}
                <p>No completed tests yet.</p>
            {% else %}
                <p>No split tests yet.</p>
                {% if canCreateTests %}
                    <a href="{{ url('abtestcraft/tests/new', { site: site.handle }) }}" class="btn submit">Create your first test</a>
                {% else %}
                    <p style="margin-top: 12px; color: #856404;">
                        <a href="{{ url('plugin-store/abtestcraft') }}" class="go">{{ 'Purchase a license'|t('abtestcraft') }}</a> {{ 'to create tests.'|t('abtestcraft') }}
                    </p>
                {% endif %}
            {% endif %}
        </div>
    {% endif %}
    </div>
{% endblock %}
