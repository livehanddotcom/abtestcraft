# Copy this to .env and configure for your environment
# Use development database for integration tests
# The tests create and clean up their own data

CRAFT_DB_DSN="pgsql:host=db;port=5432;dbname=db"
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

# Security
SECURITY_KEY=your-security-key-here

# Site
DEFAULT_SITE_URL=http://your-site.ddev.site

# Only on a throwaway test site (tests/ci/setup-site.sh sets it): enables the
# front-end and console command tests, which act on every test in the database
# ABTESTCRAFT_TEST_SITE_URL=http://127.0.0.1:8080/
